# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# n8n workflow exports — these carry API keys/credential references inline
# (n8n has no built-in secret-redaction for exported JSON), so they stay
# local-only rather than risk a key landing in the (public) repo history.
/n8n/

# typescript
*.tsbuildinfo
next-env.d.ts
